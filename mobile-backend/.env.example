# Server Configuration
PORT=5001
NODE_ENV=development

# Database Configuration
# Replace with your MongoDB connection string (Atlas or Local)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/skillconnect

# Security
# Generate a random string for JWT signing (e.g., using 'openssl rand -base64 32')
JWT_SECRET=your_super_secret_jwt_key_here

# Logging
LOG_LEVEL=debug

# CORS Configuration
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Monitoring (Optional)
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Cache (Optional)
# REDIS_URL=redis://localhost:6379
